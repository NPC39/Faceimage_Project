# Frontend Environment Variables Template
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/photomarket?schema=public"
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_APP_NAME="SnapMarket AI"

# Photo Storage Configuration
STORAGE_PROVIDER="local"
LOCAL_STORAGE_ROOT="./storage"
MAX_PHOTO_UPLOAD_MB="20"

# Cloudflare R2 Storage (Direct Browser Upload via Presigned URL)
# CORS Configuration required on R2 bucket:
# Allowed Origins: http://localhost:3000 (dev), https://<your-app>.vercel.app (prod)
# Allowed Methods: PUT, GET, HEAD
# Allowed Headers: Content-Type
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_ENDPOINT=""


# Face Service Configuration (Server-to-Server)
FACE_SERVICE_URL="http://backend:8000"
FACE_SERVICE_API_KEY=""
FACE_SERVICE_TIMEOUT_MS="60000"
FACE_PROCESSING_CONCURRENCY="2"

# Face Search Configuration (Phase 9 & Stage D Calibration)
MAX_SELFIE_UPLOAD_MB="10"
FACE_MATCH_THRESHOLD="0.40"
FACE_MATCH_AMBIGUITY_GUARD_ENABLED="true"
FACE_MATCH_AMBIGUITY_MARGIN="0.002"
FACE_SEARCH_MAX_RESULTS="100"
FACE_SEARCH_BATCH_SIZE="500"
